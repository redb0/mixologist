POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mixologist

FRONTEND_PORT=8080

# Backend
DB_URL=postgres://postgres:postgres@localhost:5432/mixologist?sslmode=disable
HTTP_ADDR=:8080
GIN_MODE=debug
LOG_LEVEL=info

# Google OAuth (замените на реальные значения из Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
# Для Vite dev (:5173) укажите http://localhost:5173/api/v1/auth/google/callback,
# чтобы OAuth redirect оставался same-origin со SPA.

# Admin allowlist: comma-separated emails, без пустых значений
AUTH_ADMIN_EMAILS=admin@example.com

# Cookie session (SESSION_COOKIE_SECRET — минимум 32 символа, не коммитьте реальное значение)
SESSION_COOKIE_SECRET=change-me-to-a-random-secret-at-least-32-chars
SESSION_COOKIE_NAME=session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_TTL=168h

# CSRF (CSRF_SECRET — минимум 32 символа, не связан с SESSION_COOKIE_SECRET)
CSRF_SECRET=change-me-to-another-random-secret-at-least-32
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
